DATABASE_URL="postgresql://postgres:password@localhost:5432/database"
PORT=3000
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Compartilhado entre os scrapers do Mercado Livre e da Amazon
SEARCH_KEYWORDS=capacete moto,jaqueta motociclista,luvas moto,bota motociclista,capa de chuva moto,protetor de motor,baú moto,alforje moto
SCRAPER_MAX_ITEMS_PER_KEYWORD=20
SCRAPER_PAGE_TIMEOUT_MS=30000
SCRAPER_NAV_DELAY_MS=2000
SCRAPER_CONCURRENCY=1
# Lotes de 3-5 keywords, com pausa de 2-5min entre lotes, pra reduzir detecção anti-bot
SCRAPER_BATCH_SIZE=4
SCRAPER_BATCH_DELAY_MS=180000
# Pausa ao detectar bloqueio (429/403, redirect de verificação, ou texto de captcha)
SCRAPER_BLOCK_COOLDOWN_MS=300000
SCRAPER_PROXY_URL=

ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
ML_SITE_ID=MLB
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
MATT_TOOL=
MATT_WORD=

# Opcional — se vazio, o scraping da Amazon fica desabilitado
AMAZON_ASSOCIATE_TAG=

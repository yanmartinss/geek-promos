DATABASE_URL="postgresql://postgres:password@localhost:5433/database"
# Credenciais do Postgres usadas pelo docker-compose.yml (POSTGRES_USER/PASSWORD/DB) —
# devem bater com o usuário/senha/banco embutidos em DATABASE_URL acima
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

PORT=3000
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WHATSAPP_ID=

OFFER_DEDUP_DAYS=7
MIN_DISCOUNT_PERCENT=20

# Compartilhado entre os scrapers do Mercado Livre e da Amazon
SEARCH_KEYWORDS=
# Regex (case-insensitive) aplicado ao título de cada oferta pelos scrapers via Playwright — descarta o que não bater
TITLE_KEYWORD_FILTER=
SCRAPER_MAX_ITEMS_PER_KEYWORD=20
# Cap específico do Mercado Livre — menor que o geral acima, pra dar mais espaço proporcional à Amazon
SCRAPER_MAX_ITEMS_PER_KEYWORD_ML=12
SCRAPER_PAGE_TIMEOUT_MS=30000
SCRAPER_NAV_DELAY_MS=2000
SCRAPER_CONCURRENCY=1
# Lotes de 3-5 keywords, com pausa de 2-5min entre lotes, pra reduzir detecção anti-bot
SCRAPER_BATCH_SIZE=4
SCRAPER_BATCH_DELAY_MS=180000
# Pausa ao detectar bloqueio (429/403, redirect de verificação, ou texto de captcha)
SCRAPER_BLOCK_COOLDOWN_MS=300000
SCRAPER_PROXY_URL=

# Credenciais do app registrado em developers.mercadolivre.com.br
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
# Site do Mercado Livre a consultar (MLB = Brasil)
ML_SITE_ID=MLB
# Preenchido automaticamente pelo fluxo de OAuth (pnpm ml:oauth)
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=

# Parâmetros fixos do programa de afiliados do Mercado Livre
MATT_TOOL=
MATT_WORD=

# Opcional — se vazio, o scraping da Amazon fica desabilitado
AMAZON_ASSOCIATE_TAG=
